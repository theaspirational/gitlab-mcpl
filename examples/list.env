# Replace the project and username placeholders, and absolute paths for your host.
GITLAB_URL=https://example.gitlab.com
GITLAB_TOKEN_FILE=/ABSOLUTE/PRIVATE/PATH/gitlab-mcpl/token
GITLAB_EXPECT_USERNAME=example-user
GITLAB_PROJECTS=group/project
GITLAB_STATE_FILE=/ABSOLUTE/PRIVATE/PATH/gitlab-mcpl/state.json
GITLAB_FEATURE_SETS=gitlab.events,gitlab.read,gitlab.comments,gitlab.mr
GITLAB_EVENT_SOURCES=todos,own-mrs,pipelines,reviewing,branches
GITLAB_BRANCH_WATCH=group/project:main
GITLAB_PIPELINE_EVENT_LOG_BYTES=4096
GITLAB_MR_TARGET_ALLOW=main
# Optional merge also needs explicit enabledFeatureSets gitlab.merge in the host:
# GITLAB_FEATURE_SETS=gitlab.events,gitlab.read,gitlab.comments,gitlab.mr,gitlab.merge
# GITLAB_MERGE_TARGET_ALLOW=main
