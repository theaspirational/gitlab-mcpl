# Placeholder-only. Replace project, identity and absolute paths before use.
# Select this file with GITLAB_MCPL_ENV_FILE for deploy/gitlab-mcpl.
GITLAB_URL=https://GITLAB_HOST.invalid
GITLAB_TOKEN_FILE=/ABSOLUTE/PRIVATE/PATH/writes-all-projects/token
GITLAB_EXPECT_USERNAME=YOUR_AGENT_ACCOUNT
GITLAB_STATE_FILE=/ABSOLUTE/PRIVATE/PATH/writes-all-projects/state.json
GITLAB_PROJECTS=*
GITLAB_READ_ALLOW=*
# * widens events, NOT writes. Name only the projects this agent may change.
GITLAB_WRITE_ALLOW=TEST_GROUP/TEST_PROJECT
GITLAB_FEATURE_SETS=gitlab.events,gitlab.read,gitlab.comments,gitlab.mr
# reviewing/threads are unsupported with *; reviewer assignment arrives via todos.
GITLAB_EVENT_SOURCES=todos,own-mrs,pipelines,branches
GITLAB_BRANCH_WATCH=TEST_GROUP/TEST_PROJECT:main
GITLAB_PIPELINE_EVENT_LOG_BYTES=4096
GITLAB_MR_TARGET_ALLOW=TEST_GROUP/TEST_PROJECT:main
# gitlab.merge intentionally stays off in both env and host recipe.
# Prefer channels.incoming plus channels.register; explicitly select gitlab.events.
# Use pushEvents instead only if required by the host; never enable both blindly.
