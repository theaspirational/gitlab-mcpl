# THROWAWAY ONLY. Replace every placeholder; never source a production env here.
# Dedicated regular test account; short-lived api PAT in a mode-600 file.
GITLAB_URL=https://GITLAB_HOST.invalid
GITLAB_TOKEN_FILE=/ABSOLUTE/PRIVATE/PATH/gitlab-mcpl-live-test/token
GITLAB_EXPECT_USERNAME=TEST_ACCOUNT
GITLAB_STATE_FILE=/ABSOLUTE/PRIVATE/PATH/gitlab-mcpl-live-test/state.json
# Exactly one disposable project, deliberately list mode for reviewing coverage.
GITLAB_PROJECTS=TEST_GROUP/TEST_PROJECT
GITLAB_READ_ALLOW=TEST_GROUP/TEST_PROJECT
GITLAB_FEATURE_SETS=gitlab.events,gitlab.read,gitlab.comments,gitlab.mr
GITLAB_EVENT_SOURCES=todos,own-mrs,pipelines,reviewing,branches
GITLAB_BRANCH_WATCH=TEST_GROUP/TEST_PROJECT:TEST_TARGET_BRANCH
GITLAB_PIPELINE_PROJECTS=TEST_GROUP/TEST_PROJECT
GITLAB_PIPELINE_SCOPE=own-mrs,own-merges
GITLAB_MR_TARGET_ALLOW=TEST_TARGET_BRANCH
GITLAB_PIPELINE_EVENT_LOG_BYTES=4096
GITLAB_POLL_INTERVAL_MS=30000
GITLAB_HOT_POLL_INTERVAL_MS=10000
# gitlab.merge is OFF by default. Only for the isolated merge test in docs/live-test.md:
# GITLAB_FEATURE_SETS=gitlab.events,gitlab.read,gitlab.comments,gitlab.mr,gitlab.merge
# GITLAB_MERGE_TARGET_ALLOW=TEST_TARGET_BRANCH
# Host must also explicitly select gitlab.merge in a grant-bearing Request.
