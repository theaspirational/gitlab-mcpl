# Placeholder-only, read/events recipe. Replace paths and identity before use.
# Select this file with GITLAB_MCPL_ENV_FILE for deploy/gitlab-mcpl.
GITLAB_URL=https://GITLAB_HOST.invalid
GITLAB_TOKEN_FILE=/ABSOLUTE/PRIVATE/PATH/all-projects/token
GITLAB_EXPECT_USERNAME=YOUR_AGENT_ACCOUNT
GITLAB_STATE_FILE=/ABSOLUTE/PRIVATE/PATH/all-projects/state.json
GITLAB_PROJECTS=*
# Explicitly permit reads everywhere visible; narrow to TEST_GROUP/* if needed.
GITLAB_READ_ALLOW=*
GITLAB_FEATURE_SETS=gitlab.events,gitlab.read
GITLAB_EVENT_SOURCES=todos,own-mrs,pipelines
GITLAB_PIPELINE_EVENT_LOG_BYTES=4096
# No WRITE_ALLOW: no write feature sets are enabled.
# gitlab.merge intentionally stays off in both env and host recipe.
# Prefer channels.incoming plus channels.register; explicitly select gitlab.events.
# Use pushEvents instead only if required by the host; never enable both blindly.
