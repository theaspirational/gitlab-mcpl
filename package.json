{
  "name": "gitlab-mcpl",
  "version": "0.1.0",
  "type": "module",
  "description": "Polling MCPL connector for self-managed GitLab 17.11+",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "gitlab-mcpl": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "docs",
    "examples",
    "deploy"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node --import tsx src/index.ts --stdio"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@animalabs/mcpl-core": "^0.4.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
