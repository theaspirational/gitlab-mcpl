# No secret contents here. Use absolute paths; EnvironmentFile does not expand $HOME.
GITLAB_URL=https://example.gitlab.com
GITLAB_TOKEN_FILE=/ABSOLUTE/PRIVATE/PATH/gitlab-mcpl/token
GITLAB_EXPECT_USERNAME=example-user
GITLAB_PROJECTS=group/project
GITLAB_READ_ALLOW=group/*
# All-projects mode (opt-in): events from every visible project minus excludes.
# READ_ALLOW must then be set explicitly, and write feature sets need
# GITLAB_WRITE_ALLOW (no bare *); see docs/configuration.md.
# GITLAB_PROJECTS=*
# GITLAB_PROJECTS_EXCLUDE=some-group/*,other/project,1234
# GITLAB_WRITE_ALLOW=group/project
GITLAB_STATE_FILE=/ABSOLUTE/PRIVATE/PATH/gitlab-mcpl/state.json
GITLAB_FEATURE_SETS=gitlab.events,gitlab.read
GITLAB_EVENT_SOURCES=todos,own-mrs,pipelines
GITLAB_PIPELINE_EVENT_LOG_BYTES=4096
GITLAB_JOB_EVENT_PATTERN=deploy:example-user
# Comment, merge-request and CI writes require api scope; do not enable until sandbox-tested:
# GITLAB_FEATURE_SETS=gitlab.events,gitlab.read,gitlab.comments,gitlab.mr,gitlab.ci,gitlab.rebase
# GITLAB_MR_TARGET_ALLOW=main
# GITLAB_MR_SOURCE_PATTERN=example-user/*
# GITLAB_CI_RETRY_REFS=main  # DANGER: deploy retry may redeploy main
# Merge is a separate opt-in, not included above:
# GITLAB_MERGE_TARGET_ALLOW=main
